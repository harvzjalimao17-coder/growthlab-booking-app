# Reference for the values Netlify will prompt for during
# "Deploy to Netlify" one-click setup. Netlify reads env var names for the
# deploy button from netlify.toml's [build.environment] plus any declared
# in the Netlify site settings UI — this file is documentation only.

NEXT_PUBLIC_SUPABASE_URL=Your Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=Your Supabase anon/public key
NEXT_PUBLIC_N8N_WEBHOOK=Your n8n production webhook URL for booking submissions
